# Local development configuration for the Payer Finance AI Search (React) app.
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# The backend authenticates through the Databricks SDK's unified auth. For local
# dev the simplest path is a CLI profile:
#
#   databricks auth login --host https://<your-workspace>.databricks.com --profile my-profile
#
# then point the app at that profile before running uvicorn:

DATABRICKS_CONFIG_PROFILE=my-profile

# Optional: override the local backend port (defaults to 8000). In Databricks
# Apps this is set automatically via $DATABRICKS_APP_PORT.
# DATABRICKS_APP_PORT=8000

# Optional: add certified Genie Space agents as extra "live" agents, alongside
# the always-on Finance/Genie One agent. JSON list; each entry needs a space_id.
# `hints` are lowercase keywords the Supervisor uses to auto-route questions.
# Leave unset to run with just the Genie One agent (works in any workspace).
# GENIE_SPACE_AGENTS='[{"id":"member360","name":"Member 360","icon":"👤","blurb":"Eligibility & risk","space_id":"<your-genie-space-id>","hints":["member","risk tier","care gap","eligibility","hcc"]}]'
